# ==============================================================================
# RAG-Based Intelligent Quiz Generation and Source-Grounded Learning System
# Multi-Provider Configuration Template
# ==============================================================================

# 1. OPTION A: Local OmniRoute (Default - Keyless Local Gateway)
# Note: The local OmniRoute endpoint (http://localhost:20128/v1) only works if the OmniRoute gateway
# is installed and running on your host system. The gateway daemon is NOT bundled with this client.
# If OmniRoute is not installed, choose one of the alternative cloud/local providers below.
LLM_PROVIDER=omniroute
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=omniroute_keyless
LLM_MODEL=agy/gemini-3.8-flash-tiered

# 2. OPTION B: NVIDIA NIM (High Performance Cloud Endpoints)
# LLM_PROVIDER=nvidia
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-your-key-here
# LLM_MODEL=meta/llama-3.1-70b-instruct

# 3. OPTION C: Groq (Ultra-Fast Inference)
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# 4. OPTION D: Google Gemini AI Studio (OpenAI Compatible Endpoint)
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIzaSy_your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash

# 5. OPTION E: OpenCode CLI / Local Free Model Proxies
# LLM_PROVIDER=opencode
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=none
# LLM_MODEL=deepseek-v3

# 6. OPTION F: Direct OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=«redacted:sk-…»
# LLM_MODEL=gpt-4o-mini

# LLM Request timeout in seconds
LLM_TIMEOUT=60.0

# ==============================================================================
# Server & Ingestion Configuration
# ==============================================================================
# Safe single-user default: 127.0.0.1 (localhost only, no authentication required)
# Set HOST=0.0.0.0 only to opt into LAN access (requires manual firewall review; no auth; no public tunnel)
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# RAG & Chunking Parameters (Aligned with OpenNotebook specifications)
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.25
